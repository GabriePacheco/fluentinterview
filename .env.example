# Default: no paid OpenAI requests. Firebase authentication and profiles are live.
# Do not put private server keys in public/.
AI_MODE=mock
OPENAI_API_KEY=
# Only this text model is allowed in the cost-controlled local implementation.
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
# Change to openai AND set a positive allowance to enable paid calls.
# Must be <= 6.00 USD. Each attempted paid request reserves 0.05 USD permanently.
AI_BUDGET_USD=0
PORT=4173
# Must match the Firebase web project; the API verifies its signed ID tokens.
FIREBASE_PROJECT_ID=fuentinterview

# Optional local subscription integration. TEST only; never use a live key.
# Provisioning reads these from the ignored .env.lemon.local file.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
APP_URL=http://127.0.0.1:4173
# Runtime authorization uses UID, not a browser-supplied email.
ADMIN_UID=
# Provisioning only: resolves an existing Firebase account to ADMIN_UID.
ADMIN_EMAIL=
SUPPORT_EMAIL=

# Optional administrator testing quota; global allowance still applies.
ADMIN_REAL_CALLS=10
